# Copy this file to .env in the project root (both the frontend and backend read it), then fill in.
# In Vercel, add the same names under Project > Settings > Environment Variables.

# ---------- Frontend (these ARE sent to the browser; only public values) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ---------- Backend only (NEVER prefix these with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Where the app runs. Used to send people back after connecting a calendar.
# Local: http://localhost:5173   Vercel: https://your-app.vercel.app
APP_URL=http://localhost:5173

# Google Calendar connection (Google Cloud > Credentials > OAuth client, Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Outlook connection (Microsoft Entra > App registrations)
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-value

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Backups if the main model is busy or out of free quota (comma-separated, tried in order).
# See which models your key can use:  python scripts/list_models.py  (from the backend folder)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# AI calls per browser per day, and for the whole site per day (protects the free quota)
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=300

# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key

CANVAS_BASE_URL=https://byui.instructure.com

# Comma-separated origins allowed to call the API (your Vercel URL + local dev)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
