# Copy this file to .env in the project root (both the frontend and backend read it), then fill in.
# In Vercel, add the same names under Project > Settings > Environment Variables.

# ---------- Frontend (these ARE sent to the browser; only public values) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# true = use built-in sample data, no backend needed
VITE_USE_MOCKS=false

# ---------- Backend only (NEVER prefix these with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Same Google OAuth client you set up in Supabase (Auth > Providers > Google)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
# Max AI calls per user per day (protects the free quota)
AI_DAILY_LIMIT=20

# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key

CANVAS_BASE_URL=https://byui.instructure.com

# Comma-separated origins allowed to call the API (your Vercel URL + local dev)
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
